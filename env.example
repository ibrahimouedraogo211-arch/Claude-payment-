# Ne créez PAS de fichier ".env" en production sur Vercel — ces variables
# se configurent dans le dashboard : Project → Settings → Environment Variables.
# Ce fichier sert juste de repère local (npm i -g vercel && vercel dev le lit).

POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLAR_ENV=sandbox
POLAR_PRODUCT_ID=c4351de7-3e3b-46f3-b4c1-7c9b1fb9805c

# Laissez vide en local (Vercel Dev simule VERCEL_URL). En prod, si vous avez
# un domaine personnalisé, définissez-le explicitement ici pour être sûr :
# PUBLIC_ORIGIN=https://monsite.com
